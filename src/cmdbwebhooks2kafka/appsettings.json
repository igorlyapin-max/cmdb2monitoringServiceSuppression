{
  "Service": {
    "Name": "cmdbwebhooks2kafka",
    "HealthRoute": "/health"
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "CmdbWebhook": {
    "Route": "/webhooks/cmdbuild",
    "Source": "CMDBuild"
  },
  "KafkaTopics": {
    "CmdbWebhookEvents": "service-suppression.cmdb.webhooks"
  }
}
