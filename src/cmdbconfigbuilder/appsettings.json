{
  "Service": {
    "Name": "cmdbconfigbuilder",
    "HealthRoute": "/health"
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "Apply": {
    "Mode": "manual",
    "AutoApplyEnabled": false,
    "SafeApply": true
  },
  "Cmdbuild": {
    "BaseUrl": "http://localhost:8090/cmdbuild/services/rest/v3",
    "Username": "admin",
    "Password": "admin",
    "RequestTimeoutMs": 10000
  },
  "Zabbix": {
    "ApiEndpoint": "http://localhost:8081/api_jsonrpc.php",
    "AuthMode": "Login",
    "ApiToken": "",
    "User": "Admin",
    "Password": "zabbix",
    "RequestTimeoutMs": 30000
  },
  "KafkaTopics": {
    "CmdbWebhookEvents": "service-suppression.cmdb.webhooks",
    "ConfigBuildRequests": "service-suppression.config.build-requests",
    "ZabbixApplyPlans": "service-suppression.zabbix.apply-plans"
  }
}
