{
  "Service": {
    "Name": "zabbixconfig2api",
    "HealthRoute": "/health"
  },
  "ConfigurationReload": {
    "Enabled": true,
    "Route": "/configuration/reload",
    "BearerToken": "CHANGE_ME_RELOAD_TOKEN",
    "BearerTokenSecret": ""
  },
  "Secrets": {
    "Provider": "None",
    "References": {},
    "IndeedPamAapm": {
      "BaseUrl": "",
      "PasswordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "ApplicationToken": "",
      "ApplicationTokenFile": "",
      "ApplicationUsername": "",
      "ApplicationPassword": "",
      "DefaultAccountPath": "",
      "SendApplicationCredentialsInQuery": false,
      "ResponseType": "json",
      "ValueJsonPath": "password",
      "PasswordExpirationInMinute": "30",
      "PasswordChangeRequired": false,
      "Comment": "cmdb2monitoring {service} {secretId}",
      "TenantId": "",
      "TimeoutMs": 10000
    }
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "Apply": {
    "Mode": "manual",
    "AutoApplyEnabled": false,
    "SafeApply": true
  },
  "Zabbix": {
    "ApiEndpoint": "",
    "AuthMode": "Login",
    "ApiToken": "",
    "User": "",
    "Password": "",
    "RequestTimeoutMs": 30000
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "",
    "ClientId": "zabbixconfig2api",
    "ConsumerGroupId": "zabbixconfig2api",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "Plain",
    "Username": "",
    "Password": "",
    "AutoOffsetReset": "Earliest",
    "ConsumeTimeoutMs": 1000,
    "MessageMaxBytes": 1048576
  },
  "KafkaTopics": {
    "ManagedIdentifier": "cmdb2monitoring-service-suppression",
    "ManagedPrefix": "service-suppression.",
    "AggregationCommands": "service-suppression.monitoring.aggregation.commands",
    "ZabbixApplyPlans": "service-suppression.zabbix.apply-plans",
    "DebugLogs": "service-suppression.logs"
  },
  "KafkaLogging": {
    "Enabled": false,
    "Topic": "service-suppression.logs",
    "MinimumLevel": "Information",
    "ServiceName": "zabbixconfig2api",
    "Environment": "Production",
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  },
  "ElkLogging": {
    "Enabled": false,
    "Endpoint": "",
    "Index": "zabbixconfig2api-logs",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "ServiceName": "zabbixconfig2api",
    "Environment": "Production",
    "TimeoutMs": 5000,
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  }
}
