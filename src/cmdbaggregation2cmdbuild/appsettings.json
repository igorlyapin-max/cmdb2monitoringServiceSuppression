{
  "Service": {
    "Name": "cmdbaggregation2cmdbuild",
    "HealthRoute": "/health"
  },
  "AllowedHosts": ["localhost", "127.0.0.1", "::1"],
  "HostValidation": {
    "Enabled": true
  },
  "TrustedProxies": {
    "Enabled": true,
    "Networks": ["127.0.0.1", "::1"]
  },
  "ConfigurationReload": {
    "Enabled": false,
    "Route": "/configuration/reload",
    "BearerToken": "",
    "BearerTokenSecret": ""
  },
  "Secrets": {
    "Provider": "None",
    "References": {},
    "IndeedPamAapm": {
      "BaseUrl": "",
      "PasswordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "ApplicationToken": "",
      "ApplicationTokenFile": "",
      "ApplicationUsername": "",
      "ApplicationPassword": "",
      "DefaultAccountPath": "",
      "SendApplicationCredentialsInQuery": false,
      "ResponseType": "json",
      "ValueJsonPath": "password",
      "PasswordExpirationInMinute": "30",
      "PasswordChangeRequired": false,
      "Comment": "cmdb2monitoring {service} {secretId}",
      "TenantId": "",
      "TimeoutMs": 10000
    }
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 600,
    "WindowSeconds": 60,
    "TrustForwardedFor": true,
    "ExcludedPathPrefixes": ["/health", "/ready", "/metrics"]
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": false,
    "HstsMaxAgeSeconds": 31536000,
    "ContentSecurityPolicy": "",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=()"
  },
  "Metrics": {
    "Enabled": true,
    "Route": "/metrics",
    "RequireBearerToken": false,
    "BearerToken": "",
    "BearerTokenSecret": "",
    "AllowedNetworks": []
  },
  "Readiness": {
    "Route": "/ready",
    "CheckExternalDependencies": false,
    "CheckTimeoutMs": 2000
  },
  "Correlation": {
    "Enabled": true,
    "HeaderName": "X-Correlation-Id"
  },
  "Resilience": {
    "Enabled": true,
    "MaxAttempts": 3,
    "BaseDelayMs": 200,
    "MaxDelayMs": 2000,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerBreakSeconds": 30
  },
  "Apply": {
    "Mode": "auto",
    "AutoApplyEnabled": true,
    "SafeApply": true
  },
  "Cmdbuild": {
    "BaseUrl": "",
    "AuthMode": "Login",
    "Username": "",
    "Password": "",
    "ApiToken": "",
    "RequestTimeoutMs": 10000
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "ClientId": "cmdbaggregation2cmdbuild",
    "ConsumerGroupId": "cmdbaggregation2cmdbuild",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "Plain",
    "Username": "",
    "Password": "",
    "AutoOffsetReset": "Earliest",
    "ConsumeTimeoutMs": 1000,
    "MessageMaxBytes": 1048576,
    "DeadLetterEnabled": true,
    "MaxProcessingAttempts": 3,
    "ProcessingRetryDelayMs": 2000
  },
  "KafkaTopics": {
    "ManagedIdentifier": "cmdb2monitoring-service-suppression",
    "ManagedPrefix": "service-suppression.",
    "CmdbWebhookEvents": "service-suppression.cmdb.events.raw",
    "AggregationCommands": "service-suppression.monitoring.aggregation.commands",
    "DeadLetterTopic": "service-suppression.dlq",
    "DebugLogs": "service-suppression.logs"
  },
  "KafkaLogging": {
    "Enabled": false,
    "Topic": "service-suppression.logs",
    "MinimumLevel": "Information",
    "ServiceName": "cmdbaggregation2cmdbuild",
    "Environment": "Production",
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  },
  "ElkLogging": {
    "Enabled": false,
    "Endpoint": "",
    "Index": "cmdbaggregation2cmdbuild-logs",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "ServiceName": "cmdbaggregation2cmdbuild",
    "Environment": "Production",
    "TimeoutMs": 5000,
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  }
}
