{
  "Service": {
    "Name": "cmdbwebhooks2kafka",
    "HealthRoute": "/health"
  },
  "Secrets": {
    "Provider": "None",
    "References": {},
    "IndeedPamAapm": {
      "BaseUrl": "",
      "PasswordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "ApplicationToken": "",
      "ApplicationTokenFile": "",
      "ApplicationUsername": "",
      "ApplicationPassword": "",
      "DefaultAccountPath": "",
      "SendApplicationCredentialsInQuery": false,
      "ResponseType": "json",
      "ValueJsonPath": "password",
      "PasswordExpirationInMinute": "30",
      "PasswordChangeRequired": false,
      "Comment": "cmdb2monitoring {service} {secretId}",
      "TenantId": "",
      "TimeoutMs": 10000
    }
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "ExcludedPathPrefixes": ["/health", "/metrics"]
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": false,
    "HstsMaxAgeSeconds": 31536000,
    "ContentSecurityPolicy": "",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=()"
  },
  "Metrics": {
    "Enabled": true,
    "Route": "/metrics"
  },
  "Correlation": {
    "Enabled": true,
    "HeaderName": "X-Correlation-Id"
  },
  "Resilience": {
    "Enabled": true,
    "MaxAttempts": 3,
    "BaseDelayMs": 200,
    "MaxDelayMs": 2000,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerBreakSeconds": 30
  },
  "CmdbWebhook": {
    "Route": "/webhooks/cmdbuild",
    "Source": "CMDBuild"
  },
  "CmdbWebhookNormalization": {
    "EventTypeFields": ["event_type", "eventType", "operation", "action", "type"],
    "ClassCodeFields": ["class_code", "classCode", "class", "_class", "className"],
    "CardIdFields": ["card_id", "cardId", "_id", "id"],
    "AttributeObjectFields": ["attributes", "values", "card", "data"]
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "ClientId": "cmdbwebhooks2kafka",
    "ConsumerGroupId": "",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "Plain",
    "Username": "",
    "Password": "",
    "AutoOffsetReset": "Earliest",
    "ConsumeTimeoutMs": 1000,
    "MessageMaxBytes": 1048576,
    "DeadLetterEnabled": true,
    "MaxProcessingAttempts": 3,
    "ProcessingRetryDelayMs": 2000
  },
  "KafkaTopics": {
    "ManagedIdentifier": "cmdb2monitoring-service-suppression",
    "ManagedPrefix": "service-suppression.",
    "CmdbWebhookEvents": "service-suppression.cmdb.events.raw",
    "AggregationCommands": "service-suppression.monitoring.aggregation.commands",
    "DeadLetterTopic": "service-suppression.dlq",
    "DebugLogs": "service-suppression.logs"
  },
  "KafkaLogging": {
    "Enabled": false,
    "Topic": "service-suppression.logs",
    "MinimumLevel": "Information",
    "ServiceName": "cmdbwebhooks2kafka",
    "Environment": "Production",
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  },
  "ElkLogging": {
    "Enabled": false,
    "Endpoint": "",
    "Index": "cmdbwebhooks2kafka-logs",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "ServiceName": "cmdbwebhooks2kafka",
    "Environment": "Production",
    "TimeoutMs": 5000,
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  }
}
