# Copy to .env for Docker Compose runs. Do not commit real credentials.

KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
KAFKA_SECURITY_PROTOCOL=Plaintext
KAFKA_SASL_MECHANISM=Plain
KAFKA_USERNAME=
KAFKA_PASSWORD=

# CMDBuild and Zabbix endpoint protocols are administrator-owned.
# Use http:// or https:// as required by the target system. For HTTPS, install
# the corporate CA or mTLS material in the container/host trust store; the app
# does not bypass certificate validation.
CMDBUILD_BASE_URL=http://host.docker.internal:8090/cmdbuild/services/rest/v3
CMDBUILD_USERNAME=
CMDBUILD_PASSWORD=
CMDBUILD_API_TOKEN=

ZABBIX_API_ENDPOINT=http://host.docker.internal:8081/api_jsonrpc.php
ZABBIX_USER=
ZABBIX_PASSWORD=
ZABBIX_API_TOKEN=

HOST_VALIDATION_ENABLED=true
SERVICE_ALLOWED_HOST_0=localhost
SERVICE_ALLOWED_HOST_1=127.0.0.1
SERVICE_ALLOWED_HOST_2=::1
SERVICE_ALLOWED_HOST_3=host.docker.internal
SERVICE_ALLOWED_HOST_4=cmdbwebhooks2kafka
SERVICE_ALLOWED_HOST_5=cmdbaggregation2cmdbuild
SERVICE_ALLOWED_HOST_6=cmdbconfigbuilder
SERVICE_ALLOWED_HOST_7=zabbixconfig2api
SERVICE_ALLOWED_HOST_8=cmdbmodelmaterializer
SERVICE_ALLOWED_HOST_9=monitoring-ui-api

TRUSTED_PROXIES_ENABLED=true
TRUSTED_PROXY_0=127.0.0.1
TRUSTED_PROXY_1=::1
TRUST_FORWARDED_FOR=true

METRICS_REQUIRE_BEARER_TOKEN=false
METRICS_BEARER_TOKEN=
METRICS_BEARER_TOKEN_SECRET=
METRICS_ALLOWED_NETWORK_0=

REDIS_ENABLED=false
REDIS_CONNECTION_STRING=

CONFIGURATION_RELOAD_ENABLED=false
CONFIGURATION_RELOAD_BEARER_TOKEN=
CONFIGURATION_RELOAD_BEARER_TOKEN_SECRET=
MATERIALIZER_RELOAD_APPLIERS_ON_SAVE=false
MATERIALIZER_RELOAD_TARGETS_ENABLED=false

# Enable only behind HTTPS ingress or HTTPS reverse proxy.
HSTS_ENABLED=false
MONITORING_UI_CONVERSION_CONFIG_STORE_BACKEND=folder
MONITORING_UI_CONVERSION_CONFIG_POSTGRES_CONNECTION_STRING=
