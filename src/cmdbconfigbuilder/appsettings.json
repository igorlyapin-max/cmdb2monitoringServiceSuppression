{
  "Service": {
    "Name": "cmdbconfigbuilder",
    "HealthRoute": "/health"
  },
  "Secrets": {
    "Provider": "None",
    "References": {},
    "IndeedPamAapm": {
      "BaseUrl": "",
      "PasswordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "ApplicationToken": "",
      "ApplicationTokenFile": "",
      "ApplicationUsername": "",
      "ApplicationPassword": "",
      "DefaultAccountPath": "",
      "SendApplicationCredentialsInQuery": false,
      "ResponseType": "json",
      "ValueJsonPath": "password",
      "PasswordExpirationInMinute": "30",
      "PasswordChangeRequired": false,
      "Comment": "cmdb2monitoring {service} {secretId}",
      "TenantId": "",
      "TimeoutMs": 10000
    }
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "Apply": {
    "Mode": "manual",
    "AutoApplyEnabled": false,
    "SafeApply": true
  },
  "ConversionRules": {
    "FilePath": "rules/conversion-rules.runtime.json",
    "ReloadOnEachEvent": true
  },
  "Readiness": {
    "ZabbixHostIdAttribute": "zabbix_main_hostid"
  },
  "SemanticDeduplication": {
    "Enabled": true,
    "WindowSeconds": 3600,
    "MaxEntries": 50000
  },
  "Cmdbuild": {
    "BaseUrl": "",
    "AuthMode": "Login",
    "Username": "",
    "Password": "",
    "ApiToken": "",
    "RequestTimeoutMs": 10000
  },
  "Zabbix": {
    "ApiEndpoint": "",
    "AuthMode": "Login",
    "ApiToken": "",
    "User": "",
    "Password": "",
    "RequestTimeoutMs": 30000
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "ClientId": "cmdbconfigbuilder",
    "ConsumerGroupId": "cmdbconfigbuilder",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "Plain",
    "Username": "",
    "Password": "",
    "AutoOffsetReset": "Earliest",
    "ConsumeTimeoutMs": 1000,
    "MessageMaxBytes": 1048576
  },
  "KafkaTopics": {
    "ManagedIdentifier": "cmdb2monitoring-service-suppression",
    "ManagedPrefix": "service-suppression.",
    "CmdbWebhookEvents": "service-suppression.cmdb.events.raw",
    "AggregationCommands": "service-suppression.monitoring.aggregation.commands",
    "ConfigBuildRequests": "service-suppression.config.build-requests",
    "ZabbixApplyPlans": "service-suppression.zabbix.apply-plans",
    "ZabbixServiceApplyPlans": "service-suppression.zabbix.service.apply-plans",
    "ZabbixSuppressionApplyPlans": "service-suppression.zabbix.suppression.apply-plans",
    "DebugLogs": "service-suppression.logs"
  },
  "KafkaLogging": {
    "Enabled": false,
    "Topic": "service-suppression.logs",
    "MinimumLevel": "Information",
    "ServiceName": "cmdbconfigbuilder",
    "Environment": "Production",
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  },
  "ElkLogging": {
    "Enabled": false,
    "Endpoint": "",
    "Index": "cmdbconfigbuilder-logs",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "ServiceName": "cmdbconfigbuilder",
    "Environment": "Production",
    "TimeoutMs": 5000,
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  }
}
