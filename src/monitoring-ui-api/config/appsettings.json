{
  "server": {
    "host": "127.0.0.1",
    "port": 8091
  },
  "allowedHosts": ["localhost", "127.0.0.1", "::1"],
  "hostValidation": {
    "enabled": true
  },
  "trustedProxies": {
    "enabled": true,
    "networks": ["127.0.0.1", "::1"]
  },
  "secrets": {
    "provider": "None",
    "references": {},
    "indeedPamAapm": {
      "baseUrl": "",
      "passwordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "applicationToken": "",
      "applicationTokenFile": "",
      "applicationUsername": "",
      "applicationPassword": "",
      "defaultAccountPath": "",
      "sendApplicationCredentialsInQuery": false,
      "responseType": "json",
      "valueJsonPath": "password",
      "passwordExpirationInMinute": "30",
      "passwordChangeRequired": false,
      "comment": "cmdb2monitoring monitoring-ui-api {secretId}",
      "tenantId": "",
      "timeoutMs": 10000
    }
  },
  "auth": {
    "mode": "local",
    "roles": ["admin", "serviceadmin", "suppressionadmin"],
    "localUsers": [],
    "saml": {
      "enabled": false,
      "groupRoleMappings": []
    },
    "oauth": {
      "enabled": false,
      "groupRoleMappings": []
    },
    "ldap": {
      "enabled": false,
      "groupRoleMappings": []
    }
  },
  "rateLimiting": {
    "enabled": true,
    "permitLimit": 600,
    "windowSeconds": 60,
    "trustForwardedFor": true,
    "excludedPathPrefixes": ["/health", "/ready", "/metrics"]
  },
  "securityHeaders": {
    "enabled": true,
    "hstsEnabled": false,
    "hstsMaxAgeSeconds": 31536000,
    "contentSecurityPolicy": "",
    "frameOptions": "DENY",
    "referrerPolicy": "no-referrer",
    "permissionsPolicy": "geolocation=(), microphone=(), camera=()"
  },
  "metrics": {
    "enabled": true,
    "route": "/metrics",
    "requireBearerToken": false,
    "bearerToken": "",
    "bearerTokenSecret": "",
    "allowedNetworks": []
  },
  "correlation": {
    "enabled": true,
    "headerName": "X-Correlation-Id"
  },
  "cmdbuildSchema": {
    "defaultPrefix": "C2M_",
    "defaultLanguage": "ru"
  },
  "backend": {
