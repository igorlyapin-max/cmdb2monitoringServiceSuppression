{
  "Service": {
    "Name": "zabbixconfig2api",
    "HealthRoute": "/health"
  },
  "ConfigurationReload": {
    "Enabled": false,
    "Route": "/configuration/reload",
    "BearerToken": "",
    "BearerTokenSecret": ""
  },
  "Secrets": {
    "Provider": "None",
    "References": {},
    "IndeedPamAapm": {
      "BaseUrl": "",
      "PasswordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "ApplicationToken": "",
      "ApplicationTokenFile": "",
      "ApplicationUsername": "",
      "ApplicationPassword": "",
      "DefaultAccountPath": "",
      "SendApplicationCredentialsInQuery": false,
      "ResponseType": "json",
      "ValueJsonPath": "password",
      "PasswordExpirationInMinute": "30",
      "PasswordChangeRequired": false,
      "Comment": "cmdb2monitoring {service} {secretId}",
      "TenantId": "",
      "TimeoutMs": 10000
    }
  },
  "Debug": {
    "Enabled": false,
    "Level": "Basic"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 600,
    "WindowSeconds": 60,
    "ExcludedPathPrefixes": ["/health", "/metrics"]
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": false,
    "HstsMaxAgeSeconds": 31536000,
    "ContentSecurityPolicy": "",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=()"
  },
  "Metrics": {
    "Enabled": true,
    "Route": "/metrics"
  },
  "Correlation": {
    "Enabled": true,
    "HeaderName": "X-Correlation-Id"
  },
  "Resilience": {
    "Enabled": true,
    "MaxAttempts": 3,
    "BaseDelayMs": 200,
    "MaxDelayMs": 2000,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerBreakSeconds": 30
  },
  "Apply": {
    "Mode": "auto",
    "AutoApplyEnabled": true,
    "SafeApply": true,
    "CreateSuppressionServices": false
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "KeyPrefix": "cmdb2m:test",
    "InstanceId": "",
    "OperationTtlSeconds": 86400,
    "LockTtlSeconds": 300,
    "LockExtendSeconds": 120,
    "CacheDefaultTtlSeconds": 300,
    "FailureMode": "fallback"
  },
  "DurableStore": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=state/cmdb2m.db",
    "MigrationsEnabled": true
  },
  "MonitoringCoverageAudit": {
    "Enabled": true,
    "SnapshotRetentionDays": 180,
    "TriggerMode": "manual",
    "DefaultExpectedPolicy": "rules_matched",
    "HostIdAttribute": "zabbix_main_hostid",
    "AllowOperationalDelta": true,
    "MaxOperationalDeltaMinutes": 30,
    "AutoSnapshotAfterFullGraphApply": false,
    "AutoSnapshotAfterScopedReconcile": false,
    "ScheduledSnapshotCron": ""
  },
  "ZabbixApplyState": {
    "FilePath": "state/zabbixconfig2api/apply-membership.json"
  },
  "ZabbixSla": {
    "Enabled": true,
    "DefaultPolicyKey": "",
    "DowntimePublicationHorizonMonths": 6,
    "ManagedExcludedDowntimePrefix": "CMDB2M REG:",
    "CmdbuildPrefix": "C2M_",
    "ServiceRootPath": "",
    "DefaultReportingPeriod": "monthly",
    "DefaultTimezone": "Europe/Moscow",
    "SampleLimit": 100
  },
  "ZabbixTriggerDependencies": {
    "Enabled": true,
    "IncludeDisabledTriggers": false,
    "AutoReconcileOnMembershipChange": true,
    "AutoReconcileDebounceSeconds": 10,
    "TransitiveGroupDependencyDepth": 2,
    "TriggerGetBatchSize": 25,
    "MaxSourceHostsPerAggregate": 1000,
    "MaxAggregateFormulaLength": 65000,
    "MaxDependenciesPerRun": 10000,
    "SampleLimit": 100,
    "AggregateHostGroupName": "CMDB2Monitoring",
    "AggregateHostName": "cmdb2monitoring-suppression-aggregates",
    "AggregateHostVisibleName": "CMDB2Monitoring suppression aggregates",
    "AggregateItemKeyPrefix": "cmdb2monitoring.suppression.aggregate",
    "AggregateStateTriggerIncludeTags": [
      {
        "Tag": "scope",
        "Value": "availability"
      }
    ],
    "AggregateStateTriggerExcludeTags": [],
    "AggregateStateTriggerIncludeNameRegex": "-",
    "AggregateStateTriggerExcludeNameRegex": "-",
    "AggregateStateTriggerMinPriority": 3,
    "DependencyTriggerIncludeTags": [],
    "DependencyTriggerExcludeTags": [],
    "DependencyTriggerIncludeNameRegex": "",
    "DependencyTriggerExcludeNameRegex": "",
    "DependencyTriggerMinPriority": 0,
    "SampleSourceTriggersPerAggregate": 20,
    "AggregateTriggerPriority": 3
  },
  "Zabbix": {
    "ApiEndpoint": "http://127.0.0.1:8081/api_jsonrpc.php",
    "AuthMode": "Login",
    "ApiToken": "",
    "User": "Admin",
    "Password": "",
    "RequestTimeoutMs": 60000
  },
  "Cmdbuild": {
    "BaseUrl": "http://127.0.0.1:8090/cmdbuild/services/rest/v3",
    "AuthMode": "Login",
    "Username": "admin",
    "Password": "",
    "ApiToken": "",
    "RequestTimeoutMs": 30000
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "ClientId": "zabbixconfig2api",
    "ConsumerGroupId": "zabbixconfig2api",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "Plain",
    "Username": "",
    "Password": "",
    "AutoOffsetReset": "Earliest",
    "ConsumeTimeoutMs": 1000,
    "MessageMaxBytes": 1048576,
    "DeadLetterEnabled": true,
    "MaxProcessingAttempts": 3,
    "ProcessingRetryDelayMs": 2000
  },
  "KafkaTopics": {
    "ManagedIdentifier": "cmdb2monitoring-service-suppression",
    "ManagedPrefix": "service-suppression.",
    "AggregationCommands": "service-suppression.monitoring.aggregation.commands",
    "ZabbixApplyPlans": "service-suppression.zabbix.apply-plans",
    "ZabbixServiceApplyPlans": "service-suppression.zabbix.service.apply-plans",
    "ZabbixSuppressionApplyPlans": "service-suppression.zabbix.suppression.apply-plans",
    "DeadLetterTopic": "service-suppression.dlq",
    "DebugLogs": "service-suppression.logs"
  },
  "KafkaLogging": {
    "Enabled": false,
    "Topic": "service-suppression.logs",
    "MinimumLevel": "Information",
    "ServiceName": "zabbixconfig2api",
    "Environment": "Production",
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  },
  "ElkLogging": {
    "Enabled": false,
    "Endpoint": "",
    "Index": "zabbixconfig2api-logs",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "ServiceName": "zabbixconfig2api",
    "Environment": "Production",
    "TimeoutMs": 5000,
    "QueueCapacity": 1000,
    "FlushTimeoutMs": 5000
  }
}
