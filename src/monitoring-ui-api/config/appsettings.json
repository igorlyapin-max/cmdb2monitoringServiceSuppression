    "username": "admin",
    "password": "",
    "passwordSecret": "",
    "apiToken": "",
    "apiTokenSecret": "",
    "timeoutMs": 10000
  },
  "appliers": {
    "reloadEnabled": false,
    "reloadBearerToken": "",
    "reloadBearerTokenSecret": "",
    "reloadTimeoutMs": 5000
  },
  "managedMicroservices": {
    "zabbixconfig2api": {
      "configFile": "src/zabbixconfig2api/appsettings.json",
      "reloadApplierId": "zabbixconfig2api"
    }
  },
  "healthChecks": [
    {
      "id": "cmdbwebhooks2kafka",
      "name": "CMDBuild webhooks -> Kafka",
